{
  "$comment": [
    "The release evidence gate (scripts/dev/release_evidence.py, judgment-pack-devkit v0.15.0), schema 2: docs/ci-evidence.md.",
    "Every job records the image identity its standard GitHub-hosted runner reports (identity), a reported identity and",
    "not a pinned VM image. Every profile is release-os: the mutation profile since #332, base and check since #336.",
    "Each job's tools must equal its profile's pins, and its image name, platform and OS-release digest what the release",
    "runner resolves; its ImageVersion is recorded and compared with nothing, so the jobs may run on different image",
    "patch versions, with different preinstalled software outside the pinned tools. The release runner resolves no tool.",
    "There is no revalidation here, because the check job does work outside the check list (the Desk and Gateway",
    "checkouts) and the mutation shards are not the check list.",
    "pull_request_reuse lists only the checks of the check and four go-race jobs whose result depends on the tree and the recorded inputs;",
    "tests/test_release_evidence.py holds every check of those jobs to one side or the other."
  ],
  "schema": 2,
  "repository": "Judgment-Pack/judgment-pack-agent",
  "branch": "main",
  "max_age_hours": 48,
  "inputs": [
    "scripts/dev/check.sh",
    "scripts/dev/changed_checks.py",
    "package-lock.json",
    "requirements-dev.txt",
    "go/go.mod",
    "go/go.sum",
    "scripts/parity.sh",
    "jpdev.json",
    "scripts/dev/generated_docs.py",
    "scripts/gen-dependencies.py",
    "scripts/dependencies-config.json",
    "scripts/dependencies-metadata.json",
    "docs/dependencies.md",
    "scripts/check-upgrade-guides.py",
    "tests/test_generated_docs.py",
    "tests/test_dependencies.py",
    "tests/test_go_release_notes.py",
    "tests/fixtures/gateway-receipts/source.json",
    "scripts/gateway-receipt-check.mjs",
    "scripts/gateway-receipt-process.mjs",
    "tests/fixtures/gateway-receipts/producer_test.go.txt",
    "tests/test_release_evidence.py"
  ],
  "fresh_at_release": [
    "tag grammar, annotated tag naming the commit, the commit on main",
    "an existing go/ tag names the release commit",
    "release notes naming the tag",
    "host upgrade guidance for the actual tag (scripts/check-upgrade-guides.py --tag)",
    "a reviewer on the release environment",
    "the package version equals the tag",
    "npm ci, build, pack and checksums",
    "build-provenance attestation",
    "no existing release, draft identity",
    "the published release holds what the run wrote",
    "the paired go/<tag> Go module tag",
    "the live dependency advisory review (docs/releasing.md)"
  ],
  "identity": {
    "manifest": ".github/runner-identity.json",
    "sha256": "333c3ffe1f5d93a863298133ad15717c384146797c0cc88f2463a361e1e358da"
  },
  "profiles": {
    "base": {
      "$comment": "The contract job (#336): python is the exact release every actions/setup-python step of the workflows asks for, as python3 --version prints it. dev.json names only its minor version, which is all the kit takes there.",
      "variant": "linux-x64",
      "platform": {"RUNNER_OS": "Linux", "RUNNER_ARCH": "X64", "ImageOS": "ubuntu26"},
      "compare": "release-os",
      "tools": {
        "python": ["python3", "--version"]
      },
      "pins": {
        "python": "Python 3.12.16"
      }
    },
    "check": {
      "$comment": "The check and race jobs (#336): node and go are dev.json's exact releases, as their commands print them, and npm the npm that Node release bundles; python is the workflows' exact setup-python release, as in base; python-packages is the virtual environment requirements-dev.txt makes with that Python and the pip it bundles.",
      "variant": "linux-x64",
      "platform": {"RUNNER_OS": "Linux", "RUNNER_ARCH": "X64", "ImageOS": "ubuntu26"},
      "compare": "release-os",
      "tools": {
        "node": ["node", "--version"],
        "npm": ["npm", "--version"],
        "go": ["go", "version"],
        "python": [".venv/bin/python3", "--version"],
        "python-packages": [".venv/bin/python3", "-c", "import importlib.metadata,json; print(json.dumps(sorted((d.metadata[\"Name\"],d.version) for d in importlib.metadata.distributions())))"]
      },
      "pins": {
        "node": "v22.23.4",
        "npm": "10.9.9",
        "go": "go version go1.26.10 linux/amd64",
        "python": "Python 3.12.16",
        "python-packages": "[[\"attrs\", \"26.1.0\"], [\"jsonschema\", \"4.26.0\"], [\"jsonschema-specifications\", \"2025.9.1\"], [\"pip\", \"25.0.1\"], [\"referencing\", \"0.37.0\"], [\"rpds-py\", \"2026.6.3\"], [\"typing_extensions\", \"4.16.0\"]]"
      }
    },
    "mutation": {
      "$comment": "The table's shards (#332): node is dev.json's exact toolchains.node.version, which mutation.yml installs, as node --version prints it; npm is the npm that Node release bundles.",
      "variant": "linux-x64",
      "platform": {"RUNNER_OS": "Linux", "RUNNER_ARCH": "X64", "ImageOS": "ubuntu26"},
      "compare": "release-os",
      "tools": {
        "node": ["node", "--version"],
        "npm": ["npm", "--version"]
      },
      "pins": {
        "node": "v22.23.4",
        "npm": "10.9.9"
      }
    }
  },
  "workflows": {
    "ci": {
      "path": ".github/workflows/ci.yml",
      "name": "CI",
      "events": ["push", "workflow_dispatch"],
      "pull_request_reuse": {
        "$comment": "Not listed, so run on every branch push: generated-docs (a generator reading Go module metadata), python-tests (reads the checkout's release tags), dependency-audit-live (a live advisory query), build (its output is read by later checks of the job) and packed-smoke (packs and installs the package).",
        "checks": [
          "record-shapes",
          "dependency-audit",
          "release-quality",
          "mutation-rows",
          "release-quality-engine",
          "reference",
          "unit-tests",
          "certify-vercel",
          "certify-codex",
          "certify-deepagents",
          "differential",
          "gateway-receipt-process",
          "gateway-receipts",
          "go-module-path",
          "gofmt",
          "go-vet",
          "go-generate",
          "go-test",
          "go-race-a",
          "go-race-b",
          "go-race-c",
          "go-race-d",
          "harness-check",
          "parity"
        ],
        "environment": [
          "CI",
          "JPDEV_DESK",
          "JP_AGENT_GATEWAY_SOURCE",
          "NODE_OPTIONS",
          "GOFLAGS",
          "GOEXPERIMENT",
          "NODE",
          "DIFF_SEED",
          "DIFF_CASE",
          "JPACK_DIALECT_RUNTIME",
          "JPACK_DIALECT_RUNTIME_MODE",
          "JPACK_DIALECT_EVIDENCE",
          "JP_RUNTIME_BINARY",
          "JP_RUNTIME_BINARY_SHA256",
          "JP_AGENT_GATEWAY_FIXTURE",
          "JP_CORPUS_ROOT",
          "JPS_CHAT_CONTEXT_STORE",
          "JPS_CHAT_CONTEXT_ID",
          "JP_CHECKPOINT_GUARD_ROOT",
          "JP_REASONING_GUARD_ROOT",
          "BODY_PARSER_PROBE_ROOT",
          "UNDICI_PROBE_ROOT",
          "GORACE",
          "GODEBUG",
          "CGO_ENABLED",
          "GOTOOLCHAIN",
          "GOPROXY",
          "GOSUMDB",
          "NODE_ENV",
          "TZ"
        ]
      },
      "jobs": {
        "contract": {
          "name": "contract",
          "job_id": "contract",
          "labels": ["ubuntu-latest"],
          "profile": "base",
          "checks": ["contract", "local-paths", "agent-docs", "diff-check"]
        },
        "check": {
          "name": "check",
          "job_id": "check",
          "labels": ["ubuntu-latest"],
          "profile": "check",
          "checks": [
            "generated-docs",
            "record-shapes",
            "python-tests",
            "dependency-audit",
            "release-quality",
            "dependency-audit-live",
            "mutation-rows",
            "build",
            "release-quality-engine",
            "packed-smoke",
            "reference",
            "unit-tests",
            "certify-vercel",
            "certify-codex",
            "certify-deepagents",
            "differential",
            "gateway-receipt-process",
            "gateway-receipts",
            "go-module-path",
            "gofmt",
            "go-vet",
            "go-generate",
            "go-test",
            "harness-check",
            "parity"
          ],
          "optional_skips": ["dependency-audit-live"],
          "setup": true
        },
        "go-race-a": {
          "name": "go-race-a",
          "job_id": "go-race",
          "labels": ["ubuntu-latest"],
          "profile": "check",
          "checks": ["go-race-a"],
          "setup": true
        },
        "go-race-b": {
          "name": "go-race-b",
          "job_id": "go-race",
          "labels": ["ubuntu-latest"],
          "profile": "check",
          "checks": ["go-race-b"],
          "setup": true
        },
        "go-race-c": {
          "name": "go-race-c",
          "job_id": "go-race",
          "labels": ["ubuntu-latest"],
          "profile": "check",
          "checks": ["go-race-c"],
          "setup": true
        },
        "go-race-d": {
          "name": "go-race-d",
          "job_id": "go-race",
          "labels": ["ubuntu-latest"],
          "profile": "check",
          "checks": ["go-race-d"],
          "setup": true
        }
      }
    },
    "mutation": {
      "path": ".github/workflows/mutation.yml",
      "name": "Mutation check",
      "events": ["workflow_dispatch"],
      "skipped_jobs": ["rows of the files this pull request changes, and a sample", "report a failed nightly table"],
      "jobs": {
        "full-1": {"name": "every row (shard 1 of 28)", "job_id": "full", "labels": ["ubuntu-latest"], "profile": "mutation", "checks": []},
        "full-2": {"name": "every row (shard 2 of 28)", "job_id": "full", "labels": ["ubuntu-latest"], "profile": "mutation", "checks": []},
