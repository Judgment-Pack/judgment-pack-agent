{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Judgment-Pack/judgment-pack-agent/blob/main/contract/schemas/history-relation-evidence.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "scope",
    "dispatchId",
    "checkpoint",
    "observationId",
    "requestDigest",
    "resultDigest",
    "target"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "observed-relation"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "role"
      ],
      "properties": {
        "execution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "dispatchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "bytes"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "job",
            "artifact",
            "dialect"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
