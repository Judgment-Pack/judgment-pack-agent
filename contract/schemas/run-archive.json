{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifest",
    "objects"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "runId",
        "source",
        "coverage",
        "commits",
        "metadata",
        "mappings",
        "members",
        "report",
        "digest"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "$ref": "#/$defs/head"
        },
        "coverage": {
          "enum": [
            "legacy-incomplete",
            "recording-incomplete"
          ]
        },
        "commits": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "history-entry.json"
          }
        },
        "metadata": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "mappings": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "exported",
              "kind",
              "representation"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/ref"
              },
              "exported": {
                "$ref": "#/$defs/ref"
              },
              "kind": {
                "enum": [
                  "checkpoint",
                  "event",
                  "observation",
                  "report",
                  "metadata",
                  "candidate",
                  "capture",
                  "evidence",
                  "source-manifest",
                  "source-chunk",
                  "request-manifest",
                  "request-chunk",
                  "chat-manifest",
                  "chat-chunk",
                  "corpus-manifest",
                  "corpus-chunk"
                ]
              },
              "representation": {
                "$ref": "#/$defs/representation"
              }
            }
          }
        },
        "members": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "digest",
              "bytes",
              "kind",
              "representation",
              "source"
            ],
            "properties": {
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "kind": {
                "enum": [
                  "checkpoint",
                  "event",
                  "observation",
                  "report",
                  "metadata",
                  "candidate",
                  "capture",
                  "evidence",
                  "source-manifest",
                  "source-chunk",
                  "request-manifest",
                  "request-chunk",
                  "chat-manifest",
                  "chat-chunk",
                  "corpus-manifest",
                  "corpus-chunk"
                ]
              },
              "representation": {
                "$ref": "#/$defs/representation"
              },
              "source": {
                "$ref": "#/$defs/ref"
              }
            }
          }
        },
        "report": {
          "$ref": "#/$defs/ref"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "digest",
          "bytes"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "string",
            "minLength": 4,
            "maxLength": 5592408,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Judgment-Pack/judgment-pack-agent/blob/main/contract/schemas/run-archive.json",
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "bytes"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "representation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "redactions"
          ],
          "properties": {
            "kind": {
              "const": "redacted-view"
            },
            "source": {
              "$ref": "#/$defs/ref"
            },
            "redactions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "runId",
        "revision",
        "executionRevision",
        "commitCount",
        "eventCount",
        "root",
        "coverage",
        "checkpoint"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executionRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commitCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "root": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "coverage": {
          "enum": [
            "legacy-incomplete",
            "recording-incomplete"
          ]
        },
        "checkpoint": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "chatId": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "manifest": {
              "type": "object",
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4194304
                }
              },
              "required": [
                "digest",
                "bytes"
              ],
              "additionalProperties": false
            },
            "turn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "closed": {
              "const": true
            },
            "privateScope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "chatId",
            "revision",
            "manifest",
            "turn"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "runId",
            "revision",
            "executionRevision",
            "count",
            "root"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "executionRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "root": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "description": "Unreleased archive1 wire contract: unique byte blobs; typed mappings and members use source digest plus kind, and member.source names that typed source. Semantic readers enforce canonical role ordering and closure."
}
