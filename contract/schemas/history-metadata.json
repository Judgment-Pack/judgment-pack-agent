{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Judgment-Pack/judgment-pack-agent/blob/main/contract/schemas/history-metadata.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "capture"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "capture"
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "bytes"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "feedback"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "feedback"
        },
        "feedback": {
          "$ref": "feedback.json"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "bytes"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            }
          }
        },
        "candidateRequested": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "candidate"
            ]
          },
          "then": {
            "required": [
              "candidateRequested"
            ]
          }
        }
      ]
    }
  ]
}
